diff --git a/src/components/TelegramCard.tsx b/src/components/TelegramCard.tsx
new file mode 100644
index 0000000..d0ee83e
--- /dev/null
+++ b/src/components/TelegramCard.tsx
@@ -0,0 +1,120 @@
+import { useEffect, useState } from 'react';
+import { CheckCircle2, ChevronRight, Loader2, Send } from 'lucide-react';
+import { COLORS, latinFont } from '../lib/theme';
+import { beginLink, botLink, haptic, isInsideTelegram, openTelegramLink } from '../lib/telegram';
+
+interface Props {
+  lang: 'KH' | 'EN';
+  telegramId: number | null | undefined;
+  telegramUsername: string | null | undefined;
+  /** Re-read the profile -- called when the person comes back from the bot. */
+  onRefresh: () => void;
+  compact?: boolean;
+}
+
+/**
+ * Telegram, on Home and Account: connect this account to the SaveIt KH bot,
+ * or -- once connected -- jump to the bot, where income/expense can be
+ * recorded in one message and the plan can be paid for.
+ */
+export default function TelegramCard({ lang, telegramId, telegramUsername, onRefresh, compact }: Props) {
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const tr = (kh: string, en: string) => (lang === 'KH' ? kh : en);
+  const linked = Boolean(telegramId);
+
+  // The link is confirmed in Telegram, then the person switches back here:
+  // re-read the profile the moment the page is visible again.
+  useEffect(() => {
+    if (linked) return;
+    const onVisible = () => {
+      if (document.visibilityState === 'visible') onRefresh();
+    };
+    document.addEventListener('visibilitychange', onVisible);
+    return () => document.removeEventListener('visibilitychange', onVisible);
+  }, [linked, onRefresh]);
+
+  const connect = async () => {
+    haptic();
+    setBusy(true);
+    setError('');
+    try {
+      openTelegramLink(await beginLink());
+    } catch {
+      setError(tr('មិនអាចភ្ជាប់បានឥឡូវនេះ សូមព្យាយាមម្ដងទៀត', 'Could not connect right now, please try again'));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const openBot = async () => {
+    haptic();
+    const url = await botLink('invoice');
+    if (url) openTelegramLink(url);
+  };
+
+  // Already inside the bot's Mini App and connected: nothing to offer.
+  if (linked && isInsideTelegram() && compact) return null;
+
+  return (
+    <div
+      className="relative overflow-hidden rounded-2xl p-3.5 flex items-center gap-3"
+      style={{
+        background: linked ? '#FFFFFF' : 'linear-gradient(135deg, #2AABEE, #1D8FD1)',
+        boxShadow: linked ? '0 2px 8px rgba(12,68,124,0.08)' : '0 6px 16px rgba(34,158,217,0.35)',
+        border: linked ? `1px solid ${COLORS.border}` : 'none',
+      }}
+    >
+      {!linked && (
+        <div
+          className="pointer-events-none absolute rounded-full"
+          style={{ width: 120, height: 120, top: -50, right: -30, background: 'rgba(255,255,255,0.12)' }}
+        />
+      )}
+      <div
+        className="relative flex items-center justify-center rounded-xl flex-shrink-0"
+        style={{ width: 40, height: 40, background: linked ? '#E7F5FD' : 'rgba(255,255,255,0.2)' }}
+      >
+        <Send size={19} color={linked ? '#229ED9' : '#FFFFFF'} strokeWidth={2.2} />
+      </div>
+      <div className="relative flex-1 min-w-0">
+        {linked ? (
+          <>
+            <p className="text-xs font-bold flex items-center gap-1" style={{ color: COLORS.navy }}>
+              <CheckCircle2 size={13} color={COLORS.success} strokeWidth={2.5} />
+              {tr('បានភ្ជាប់ Telegram', 'Telegram connected')}
+            </p>
+            <p className="text-[11px] truncate" style={{ color: COLORS.muted, ...latinFont }}>
+              {telegramUsername ? `@${telegramUsername}` : `ID ${telegramId}`}
+              {' · '}
+              {tr('កត់ចំណូល/ចំណាយពី bot', 'record from the bot')}
+            </p>
+          </>
+        ) : (
+          <>
+            <p className="text-sm font-bold text-white">{tr('ភ្ជាប់ Telegram', 'Connect Telegram')}</p>
+            <p className="text-[11px] text-white/85 leading-snug">
+              {error ||
+                tr(
+                  'ចូលដោយមិនបាច់លេខសម្ងាត់ · កត់ចំណូលពី bot · បង់តាម KHQR',
+                  'Password-free sign-in · record from the bot · pay by KHQR'
+                )}
+            </p>
+          </>
+        )}
+      </div>
+      <button
+        onClick={linked ? openBot : connect}
+        disabled={busy}
+        className="relative flex items-center gap-0.5 px-3 py-1.5 rounded-full flex-shrink-0 text-[11px] font-bold disabled:opacity-70"
+        style={{
+          backgroundColor: linked ? '#E7F5FD' : '#FFFFFF',
+          color: '#1D8FD1',
+        }}
+      >
+        {busy ? <Loader2 size={13} className="animate-spin" /> : linked ? tr('បើក Bot', 'Open bot') : tr('ភ្ជាប់', 'Connect')}
+        {!busy && <ChevronRight size={13} strokeWidth={2.5} />}
+      </button>
+    </div>
+  );
+}
