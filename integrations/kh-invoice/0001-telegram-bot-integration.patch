--- /dev/null
+++ b/src/lib/telegram.ts
@@ -0,0 +1,149 @@
+import { supabase } from './supabaseClient';
+
+/**
+ * Telegram sign-in for KH Invoice, through the `telegram-bridge` edge
+ * function. Two ways in:
+ *   - inside Telegram (opened from the SaveIt KH bot as a Mini App): the
+ *     signed initData Telegram hands the page is exchanged for a session,
+ *     so the person is simply signed in -- no phone, no password;
+ *   - in an ordinary browser: a one-time code is confirmed in the bot, and
+ *     this page polls until it is.
+ */
+
+type TelegramWebApp = {
+  initData: string;
+  initDataUnsafe?: { user?: { id: number; first_name?: string; username?: string } };
+  colorScheme?: 'light' | 'dark';
+  ready: () => void;
+  expand: () => void;
+  setHeaderColor?: (color: string) => void;
+  setBackgroundColor?: (color: string) => void;
+  openTelegramLink?: (url: string) => void;
+  HapticFeedback?: { impactOccurred: (style: 'light' | 'medium' | 'heavy') => void };
+};
+
+declare global {
+  interface Window {
+    Telegram?: { WebApp?: TelegramWebApp };
+  }
+}
+
+const BRIDGE_URL = `${import.meta.env.VITE_SUPABASE_URL}/functions/v1/telegram-bridge`;
+
+export function telegramWebApp(): TelegramWebApp | null {
+  const app = window.Telegram?.WebApp;
+  return app && app.initData ? app : null;
+}
+
+export const isInsideTelegram = () => telegramWebApp() !== null;
+
+/** Makes the Mini App feel native: full height, header in the app's colour. */
+export function prepareTelegramChrome(headerColor: string) {
+  const app = telegramWebApp();
+  if (!app) return;
+  try {
+    app.ready();
+    app.expand();
+    app.setHeaderColor?.(headerColor);
+  } catch {
+    /* older Telegram clients lack some of these */
+  }
+}
+
+export function haptic() {
+  try {
+    telegramWebApp()?.HapticFeedback?.impactOccurred('light');
+  } catch {
+    /* not in Telegram */
+  }
+}
+
+async function callBridge<T>(action: string, body: Record<string, unknown> = {}, withAuth = false): Promise<T> {
+  const headers: Record<string, string> = {
+    'Content-Type': 'application/json',
+    apikey: import.meta.env.VITE_SUPABASE_ANON_KEY,
+  };
+  if (withAuth) {
+    const { data } = await supabase.auth.getSession();
+    if (data.session) headers.Authorization = `Bearer ${data.session.access_token}`;
+  }
+  const res = await fetch(BRIDGE_URL, { method: 'POST', headers, body: JSON.stringify({ action, ...body }) });
+  const json = await res.json().catch(() => ({}));
+  if (!res.ok) throw new Error(json?.error || `Request failed (${res.status})`);
+  return json as T;
+}
+
+type SessionTokens = { access_token: string; refresh_token: string };
+
+async function adopt(session: SessionTokens) {
+  const { data, error } = await supabase.auth.setSession(session);
+  if (error || !data.session) throw new Error(error?.message || 'Could not sign in');
+  return data.session;
+}
+
+let botUsernamePromise: Promise<string | null> | null = null;
+/** The bot's @username (without @), or null while the bridge isn't set up. */
+export function botUsername(): Promise<string | null> {
+  if (!botUsernamePromise) {
+    botUsernamePromise = callBridge<{ bot_username: string | null }>('config')
+      .then((r) => r.bot_username)
+      .catch(() => {
+        botUsernamePromise = null;
+        return null;
+      });
+  }
+  return botUsernamePromise;
+}
+
+export async function botLink(start?: string) {
+  const name = await botUsername();
+  if (!name) return null;
+  return `https://t.me/${name}${start ? `?start=${start}` : ''}`;
+}
+
+/** Opens a t.me link: in-app when we are a Mini App, a new tab otherwise. */
+export function openTelegramLink(url: string) {
+  const app = telegramWebApp();
+  if (app?.openTelegramLink) app.openTelegramLink(url);
+  else window.open(url, '_blank', 'noopener');
+}
+
+/** Inside Telegram: sign in (creating the account the first time). */
+export async function signInWithMiniApp() {
+  const app = telegramWebApp();
+  if (!app) throw new Error('Not inside Telegram');
+  const r = await callBridge<{ session: SessionTokens }>('miniapp_login', { initData: app.initData });
+  return adopt(r.session);
+}
+
+/**
+ * In a browser: returns the bot link to open, and a promise that resolves
+ * with the session once the person taps "Yes" in the bot. `cancel()` stops
+ * waiting.
+ */
+export async function beginBrowserLogin() {
+  const begin = await callBridge<{ code: string; url: string | null; expires_in: number }>('login_begin');
+  if (!begin.url) throw new Error('bot-not-ready');
+  let stopped = false;
+  const done = (async () => {
+    const deadline = Date.now() + begin.expires_in * 1000;
+    while (!stopped && Date.now() < deadline) {
+      await new Promise((r) => setTimeout(r, 2000));
+      if (stopped) break;
+      const r = await callBridge<{ status: string; session?: SessionTokens }>('login_poll', { code: begin.code }).catch(
+        () => ({ status: 'pending' }) as { status: string; session?: SessionTokens }
+      );
+      if (r.status === 'ok' && r.session) return adopt(r.session);
+      if (r.status === 'expired') break;
+    }
+    throw new Error(stopped ? 'cancelled' : 'expired');
+  })();
+  return { url: begin.url, done, cancel: () => { stopped = true; } };
+}
+
+/** For a signed-in phone account: the bot link that attaches this Telegram. */
+export async function beginLink() {
+  const r = await callBridge<{ url: string | null }>('link_begin', {}, true);
+  if (!r.url) throw new Error('bot-not-ready');
+  return r.url;
+}
diff --git a/supabase/functions/telegram-bridge/index.ts b/supabase/functions/telegram-bridge/index.ts
new file mode 100644
index 0000000..e590d09
--- /dev/null
+++ b/supabase/functions/telegram-bridge/index.ts
@@ -0,0 +1,451 @@
+// Telegram <-> KH Invoice.
+//
+// Browser/Mini App calls (no shared secret):
+//   config          -> the bot's username, for t.me links
+//   miniapp_login   -> signed Telegram Mini App initData in, a session out
+//   login_begin     -> a code the person confirms in the bot ("sign in with Telegram")
+//   login_poll      -> the session, once the bot has confirmed that code
+//   link_begin      -> (signed-in user) a code that attaches Telegram to this account
+//
+// SaveIt bot calls (X-Bridge-Secret):
+//   hello, approve, status, plans, add_tx, unpaid, activate
+//
+// Telegram signatures are checked by the SaveIt backend, which holds the bot
+// token; this function never sees the token.
+import { createClient, type SupabaseClient } from "npm:@supabase/supabase-js@2";
+
+const SUPABASE_URL = Deno.env.get("SUPABASE_URL")!;
+const SERVICE_KEY = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;
+const ANON_KEY = Deno.env.get("SUPABASE_ANON_KEY")!;
+
+const TRIAL_DAYS = 30;
+const LOGIN_CODE_TTL_MS = 5 * 60 * 1000;
+const LINK_CODE_TTL_MS = 15 * 60 * 1000;
+
+export const PLANS = [
+  { key: "1m", months: 1, price: 2, label_km: "១ ខែ", label_en: "1 Month" },
+  { key: "6m", months: 6, price: 7, label_km: "៦ ខែ", label_en: "6 Months" },
+  { key: "1y", months: 12, price: 14, label_km: "១ ឆ្នាំ", label_en: "1 Year" },
+];
+
+const CORS = {
+  "Access-Control-Allow-Origin": "*",
+  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type, x-bridge-secret",
+  "Access-Control-Allow-Methods": "POST, OPTIONS",
+};
+
+const admin = createClient(SUPABASE_URL, SERVICE_KEY, { auth: { persistSession: false } });
+
+type TgUser = { id: number; username?: string | null; first_name?: string | null };
+type Json = Record<string, unknown>;
+
+class HttpError extends Error {
+  constructor(public status: number, message: string) {
+    super(message);
+  }
+}
+
+function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), { status, headers: { ...CORS, "Content-Type": "application/json" } });
+}
+
+let configCache: { secret: string; verifier_url: string; bot_username: string | null; at: number } | null = null;
+async function bridgeConfig() {
+  if (configCache && Date.now() - configCache.at < 60_000) return configCache;
+  const { data, error } = await admin.from("bridge_config").select("secret, verifier_url, bot_username").eq("id", 1).maybeSingle();
+  if (error || !data) throw new HttpError(503, "Telegram bridge is not configured.");
+  configCache = { ...data, at: Date.now() };
+  return configCache;
+}
+
+function sameSecret(a: string, b: string) {
+  if (!a || a.length !== b.length) return false;
+  let diff = 0;
+  for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
+  return diff === 0;
+}
+
+function randomCode(bytes = 18) {
+  const raw = crypto.getRandomValues(new Uint8Array(bytes));
+  return btoa(String.fromCharCode(...raw)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+}
+
+function botLink(botUsername: string | null, start: string) {
+  return botUsername ? `https://t.me/${botUsername}?start=${start}` : null;
+}
+
+// Cambodia is UTC+7 all year, so "today" for a shop means Phnom Penh's date.
+function phnomPenhDate(offsetDays = 0) {
+  const d = new Date(Date.now() + 7 * 3600_000 + offsetDays * 86_400_000);
+  return d.toISOString().slice(0, 10);
+}
+
+// ------------------------------------------------------------- accounts
+
+async function profileByTelegram(telegramId: number) {
+  const { data } = await admin.from("profiles").select("*").eq("telegram_id", telegramId).maybeSingle();
+  return data;
+}
+
+/** The account for this Telegram user, created (with a fresh trial) the first time. */
+async function ensureAccount(tg: TgUser) {
+  const existing = await profileByTelegram(tg.id);
+  if (existing) {
+    await admin
+      .from("profiles")
+      .update({ telegram_username: tg.username ?? null, telegram_first_name: tg.first_name ?? null })
+      .eq("id", existing.id);
+    return existing;
+  }
+
+  const email = `tg${tg.id}@khinvoice.app`;
+  let userId: string | null = null;
+  const created = await admin.auth.admin.createUser({
+    email,
+    email_confirm: true,
+    password: randomCode(24),
+    user_metadata: { telegram_id: tg.id },
+  });
+  if (created.data?.user) {
+    userId = created.data.user.id;
+  } else {
+    // Already exists (an earlier attempt got this far): recover its id.
+    const link = await admin.auth.admin.generateLink({ type: "magiclink", email });
+    userId = link.data?.user?.id ?? null;
+  }
+  if (!userId) throw new HttpError(500, "Could not create the account.");
+
+  const name = tg.first_name || tg.username || "My Business";
+  // ignoreDuplicates: a profile left behind by an earlier half-finished
+  // attempt keeps its original trial start instead of getting a new one.
+  const { error } = await admin.from("profiles").upsert(
+    {
+      id: userId,
+      business_name: name,
+      username: tg.username ?? null,
+      trial_started_at: new Date().toISOString(),
+      is_locked: false,
+    },
+    { onConflict: "id", ignoreDuplicates: true }
+  );
+  if (error) throw new HttpError(500, error.message);
+  const { data: profile, error: linkError } = await admin
+    .from("profiles")
+    .update({ telegram_id: tg.id, telegram_username: tg.username ?? null, telegram_first_name: tg.first_name ?? null })
+    .eq("id", userId)
+    .select("*")
+    .single();
+  if (linkError) throw new HttpError(500, linkError.message);
+  return profile;
+}
+
+async function emailOf(userId: string) {
+  const { data } = await admin.auth.admin.getUserById(userId);
+  const email = data?.user?.email;
+  if (!email) throw new HttpError(500, "Account has no sign-in identity.");
+  return email;
+}
+
+/** A real Supabase session for this user, without any password. */
+async function sessionFor(userId: string) {
+  const email = await emailOf(userId);
+  const link = await admin.auth.admin.generateLink({ type: "magiclink", email });
+  const tokenHash = link.data?.properties?.hashed_token;
+  if (!tokenHash) throw new HttpError(500, link.error?.message ?? "Could not start a session.");
+  const anon = createClient(SUPABASE_URL, ANON_KEY, { auth: { persistSession: false } });
+  const { data, error } = await anon.auth.verifyOtp({ token_hash: tokenHash, type: "magiclink" });
+  if (error || !data.session) throw new HttpError(500, error?.message ?? "Could not start a session.");
+  return { access_token: data.session.access_token, refresh_token: data.session.refresh_token };
+}
+
+function assertUnlocked(profile: { is_locked?: boolean | null }) {
+  if (profile?.is_locked) throw new HttpError(403, "locked");
+}
+
+// ------------------------------------------------------------- status
+
+function trialDaysLeft(trialStartedAt: string | null) {
+  if (!trialStartedAt) return TRIAL_DAYS;
+  const elapsed = Math.floor((Date.now() - new Date(trialStartedAt).getTime()) / 86_400_000);
+  return Math.max(0, TRIAL_DAYS - elapsed);
+}
+
+function sumBy(rows: { type: string; currency: string; amount: number }[], type: string, currency: string) {
+  return rows.filter((r) => r.type === type && r.currency === currency).reduce((a, r) => a + Number(r.amount), 0);
+}
+
+async function summary(db: SupabaseClient, profile: Json) {
+  const userId = profile.id as string;
+  const today = phnomPenhDate();
+  const monthStart = `${today.slice(0, 7)}-01`;
+
+  const [{ data: tx }, { data: invoices }, { data: products }] = await Promise.all([
+    db.from("transactions").select("type, currency, amount, transaction_date").eq("user_id", userId).gte("transaction_date", monthStart),
+    db.from("invoices").select("subtotal, discount, paid_amount, currency, status").eq("user_id", userId).neq("status", "paid"),
+    db.from("products").select("quantity, low_stock_threshold").eq("user_id", userId).eq("is_active", true),
+  ]);
+
+  const month = (tx ?? []) as { type: string; currency: string; amount: number; transaction_date: string }[];
+  const day = month.filter((r) => r.transaction_date === today);
+  let unpaidUSD = 0;
+  let unpaidKHR = 0;
+  let unpaidCount = 0;
+  for (const inv of (invoices ?? []) as { subtotal: number; discount: number; paid_amount: number; currency: string }[]) {
+    const left = Number(inv.subtotal) - Number(inv.discount) - Number(inv.paid_amount);
+    if (left <= 0.005) continue;
+    unpaidCount++;
+    if (inv.currency === "KHR") unpaidKHR += left;
+    else unpaidUSD += left;
+  }
+  const lowStock = ((products ?? []) as { quantity: number; low_stock_threshold: number }[]).filter(
+    (p) => Number(p.quantity) <= Number(p.low_stock_threshold)
+  ).length;
+
+  const expires = profile.subscription_expires_at as string | null;
+  const subscribed = Boolean(expires) && new Date(expires!).getTime() > Date.now();
+  return {
+    linked: true,
+    business_name: profile.business_name,
+    subscribed,
+    subscription_expires_at: expires,
+    trial_days_left: trialDaysLeft(profile.trial_started_at as string | null),
+    trial_days_total: TRIAL_DAYS,
+    today: {
+      income_usd: sumBy(day, "income", "USD"),
+      income_khr: sumBy(day, "income", "KHR"),
+      expense_usd: sumBy(day, "expense", "USD"),
+      expense_khr: sumBy(day, "expense", "KHR"),
+    },
+    month: {
+      income_usd: sumBy(month, "income", "USD"),
+      income_khr: sumBy(month, "income", "KHR"),
+      expense_usd: sumBy(month, "expense", "USD"),
+      expense_khr: sumBy(month, "expense", "KHR"),
+    },
+    unpaid: { count: unpaidCount, usd: unpaidUSD, khr: unpaidKHR },
+    low_stock: lowStock,
+  };
+}
+
+// ------------------------------------------------------------- handlers
+
+async function verifyInitData(initData: string): Promise<TgUser> {
+  const cfg = await bridgeConfig();
+  const res = await fetch(`${cfg.verifier_url.replace(/\/$/, "")}/api/kh-invoice/verify`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json", "X-Bridge-Secret": cfg.secret },
+    body: JSON.stringify({ initData }),
+  });
+  const body = await res.json().catch(() => ({}));
+  if (!res.ok || !body?.ok || !body.user?.id) throw new HttpError(401, "Telegram could not confirm who you are.");
+  return body.user as TgUser;
+}
+
+async function publicAction(action: string, body: Json, req: Request) {
+  if (action === "config") {
+    const cfg = await bridgeConfig();
+    return { bot_username: cfg.bot_username, plans: PLANS };
+  }
+
+  if (action === "miniapp_login") {
+    const tg = await verifyInitData(String(body.initData ?? ""));
+    const profile = await ensureAccount(tg);
+    assertUnlocked(profile);
+    return { session: await sessionFor(profile.id) };
+  }
+
+  if (action === "login_begin") {
+    const cfg = await bridgeConfig();
+    const code = randomCode();
+    await admin.from("telegram_codes").delete().lt("expires_at", new Date(Date.now() - 86_400_000).toISOString());
+    await admin.from("telegram_codes").insert({ code, kind: "login", expires_at: new Date(Date.now() + LOGIN_CODE_TTL_MS).toISOString() });
+    return { code, url: botLink(cfg.bot_username, `inl_${code}`), expires_in: LOGIN_CODE_TTL_MS / 1000 };
+  }
+
+  if (action === "login_poll") {
+    const code = String(body.code ?? "");
+    const { data: row } = await admin.from("telegram_codes").select("*").eq("code", code).eq("kind", "login").maybeSingle();
+    if (!row || row.consumed_at || new Date(row.expires_at).getTime() < Date.now()) return { status: "expired" };
+    if (!row.approved_at || !row.telegram_id) return { status: "pending" };
+    // Claim it before issuing, so one approval can only ever sign in once.
+    const { data: claimed } = await admin
+      .from("telegram_codes")
+      .update({ consumed_at: new Date().toISOString() })
+      .eq("code", code)
+      .is("consumed_at", null)
+      .select("code");
+    if (!claimed?.length) return { status: "expired" };
+    const profile = await ensureAccount({ id: row.telegram_id, username: row.telegram_username, first_name: row.telegram_first_name });
+    assertUnlocked(profile);
+    return { status: "ok", session: await sessionFor(profile.id) };
+  }
+
+  if (action === "link_begin") {
+    const auth = req.headers.get("Authorization") ?? "";
+    const { data } = await admin.auth.getUser(auth.replace(/^Bearer\s+/i, ""));
+    if (!data?.user) throw new HttpError(401, "Sign in first.");
+    const cfg = await bridgeConfig();
+    const code = randomCode();
+    await admin.from("telegram_codes").insert({
+      code,
+      kind: "link",
+      user_id: data.user.id,
+      expires_at: new Date(Date.now() + LINK_CODE_TTL_MS).toISOString(),
+    });
+    return { url: botLink(cfg.bot_username, `inlk_${code}`) };
+  }
+
+  throw new HttpError(400, "Unknown action.");
+}
+
+function tgFrom(body: Json): TgUser {
+  const t = (body.telegram ?? {}) as Json;
+  const id = Number(t.id ?? body.telegram_id);
+  if (!Number.isSafeInteger(id) || id <= 0) throw new HttpError(400, "telegram id required");
+  return { id, username: (t.username as string) ?? null, first_name: (t.first_name as string) ?? null };
+}
+
+async function bridgeAction(action: string, body: Json) {
+  if (action === "hello") {
+    const username = String(body.bot_username ?? "").replace(/^@/, "");
+    if (!/^[A-Za-z0-9_]{5,64}$/.test(username)) throw new HttpError(400, "bad bot username");
+    await admin.from("bridge_config").update({ bot_username: username, updated_at: new Date().toISOString() }).eq("id", 1);
+    configCache = null;
+    return { ok: true };
+  }
+
+  if (action === "plans") return { plans: PLANS };
+
+  if (action === "approve") {
+    const tg = tgFrom(body);
+    const code = String(body.code ?? "");
+    const { data: row } = await admin.from("telegram_codes").select("*").eq("code", code).maybeSingle();
+    if (!row || row.consumed_at || row.approved_at || new Date(row.expires_at).getTime() < Date.now()) {
+      return { ok: false, error: "expired" };
+    }
+    if (row.kind === "login") {
+      const existing = await profileByTelegram(tg.id);
+      if (existing?.is_locked) return { ok: false, error: "locked" };
+      await admin
+        .from("telegram_codes")
+        .update({ approved_at: new Date().toISOString(), telegram_id: tg.id, telegram_username: tg.username, telegram_first_name: tg.first_name })
+        .eq("code", code)
+        .is("approved_at", null);
+      return { ok: true, kind: "login", is_new: !existing };
+    }
+    // kind = link: attach this Telegram to the account that asked for it.
+    const other = await profileByTelegram(tg.id);
+    if (other && other.id !== row.user_id) return { ok: false, error: "telegram_in_use", business_name: other.business_name };
+    const { data: target } = await admin.from("profiles").select("id, business_name").eq("id", row.user_id).maybeSingle();
+    if (!target) return { ok: false, error: "expired" };
+    await admin
+      .from("profiles")
+      .update({ telegram_id: tg.id, telegram_username: tg.username, telegram_first_name: tg.first_name })
+      .eq("id", row.user_id);
+    await admin.from("telegram_codes").update({ approved_at: new Date().toISOString(), consumed_at: new Date().toISOString(), telegram_id: tg.id }).eq("code", code);
+    return { ok: true, kind: "link", business_name: target.business_name };
+  }
+
+  if (action === "status") {
+    const profile = await profileByTelegram(tgFrom(body).id);
+    if (!profile) return { linked: false, trial_days_total: TRIAL_DAYS, plans: PLANS };
+    return { ...(await summary(admin, profile)), plans: PLANS };
+  }
+
+  if (action === "add_tx") {
+    const profile = await profileByTelegram(tgFrom(body).id);
+    if (!profile) return { ok: false, error: "not_linked" };
+    if (profile.is_locked) return { ok: false, error: "locked" };
+    const type = body.type === "expense" ? "expense" : "income";
+    const currency = body.currency === "KHR" ? "KHR" : "USD";
+    const amount = Number(body.amount);
+    if (!Number.isFinite(amount) || amount <= 0 || amount > 1e12) return { ok: false, error: "bad_amount" };
+    const description = String(body.description ?? "").trim().slice(0, 200) || (type === "income" ? "ចំណូល (Telegram)" : "ចំណាយ (Telegram)");
+    const { error } = await admin.from("transactions").insert({
+      user_id: profile.id,
+      type,
+      description,
+      quantity: 1,
+      unit_price: amount,
+      currency,
+      transaction_date: phnomPenhDate(),
+      source: "manual",
+    });
+    if (error) return { ok: false, error: error.message };
+    return { ok: true, ...(await summary(admin, profile)) };
+  }
+
+  if (action === "unpaid") {
+    const profile = await profileByTelegram(tgFrom(body).id);
+    if (!profile) return { ok: false, error: "not_linked" };
+    const { data } = await admin
+      .from("invoices")
+      .select("invoice_number, customer_name, invoice_date, subtotal, discount, paid_amount, currency, status")
+      .eq("user_id", profile.id)
+      .neq("status", "paid")
+      .order("invoice_date", { ascending: false })
+      .limit(10);
+    const list = (data ?? [])
+      .map((i) => ({ ...i, left: Number(i.subtotal) - Number(i.discount) - Number(i.paid_amount) }))
+      .filter((i) => i.left > 0.005);
+    return { ok: true, invoices: list };
+  }
+
+  if (action === "activate") {
+    const tg = tgFrom(body);
+    const plan = PLANS.find((p) => p.key === body.plan);
+    if (!plan) throw new HttpError(400, "unknown plan");
+    const ref = String(body.ref ?? "").slice(0, 120);
+    if (!ref) throw new HttpError(400, "ref required");
+
+    // Idempotent on the payment reference: a retried call must not add months twice.
+    const profile = await ensureAccount(tg);
+    const { data: prior } = await admin.from("subscription_requests").select("id, status").eq("transaction_id", ref).maybeSingle();
+    let requestId = prior?.id as string | undefined;
+    if (!prior) {
+      const { data: inserted, error } = await admin
+        .from("subscription_requests")
+        .insert({
+          user_id: profile.id,
+          plan: plan.key,
+          amount: plan.price,
+          description: "Paid via SaveIt KH Telegram bot",
+          transaction_id: ref,
+          payment_date: phnomPenhDate(),
+          status: "pending",
+        })
+        .select("id")
+        .single();
+      if (error) throw new HttpError(500, error.message);
+      requestId = inserted.id;
+    }
+    if (prior?.status !== "confirmed") {
+      // The existing AFTER UPDATE trigger extends subscription_expires_at.
+      await admin.from("subscription_requests").update({ status: "confirmed" }).eq("id", requestId).eq("status", "pending");
+    }
+    const { data: after } = await admin.from("profiles").select("subscription_expires_at").eq("id", profile.id).single();
+    return { ok: true, subscription_expires_at: after?.subscription_expires_at ?? null, plan: plan.key };
+  }
+
+  throw new HttpError(400, "Unknown action.");
+}
+
+Deno.serve(async (req) => {
+  if (req.method === "OPTIONS") return new Response("ok", { headers: CORS });
+  if (req.method !== "POST") return json({ error: "POST only" }, 405);
+  try {
+    const body = (await req.json().catch(() => ({}))) as Json;
+    const action = String(body.action ?? "");
+    const presented = req.headers.get("X-Bridge-Secret");
+    if (presented !== null) {
+      const cfg = await bridgeConfig();
+      if (!sameSecret(presented, cfg.secret)) return json({ error: "forbidden" }, 403);
+      return json(await bridgeAction(action, body));
+    }
+    return json(await publicAction(action, body, req));
+  } catch (err) {
+    const status = err instanceof HttpError ? err.status : 500;
+    if (status >= 500) console.error("telegram-bridge:", err);
+    return json({ error: err instanceof Error ? err.message : String(err) }, status);
+  }
