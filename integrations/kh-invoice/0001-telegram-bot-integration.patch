+-- Telegram sign-in + SaveIt bot bridge.
+--
+-- profiles.telegram_id ties an account to one Telegram user. It is filled
+-- by the telegram-bridge edge function (service role) only: a person proves
+-- who they are either with Mini App initData or by confirming in the bot.
+
+alter table public.profiles add column if not exists telegram_id bigint unique;
+alter table public.profiles add column if not exists telegram_username text;
+alter table public.profiles add column if not exists telegram_first_name text;
+
+-- Users may still edit their own profile, but never the Telegram link
+-- (anyone could claim another person's Telegram id) nor their billing
+-- state (anyone could grant themselves a subscription). Those change only
+-- through the service role or the SECURITY DEFINER subscription trigger.
+create or replace function public.protect_telegram_link()
+returns trigger language plpgsql set search_path = public as $$
+begin
+  if coalesce(auth.role(), '') = 'service_role' or current_user = 'postgres' then
+    return new;
+  end if;
+  if tg_op = 'INSERT' then
+    new.telegram_id := null;
+    new.telegram_username := null;
+    new.telegram_first_name := null;
+    new.subscription_expires_at := null;
+    new.is_locked := false;
+    new.trial_started_at := now();
+  else
+    new.telegram_id := old.telegram_id;
+    new.telegram_username := old.telegram_username;
+    new.telegram_first_name := old.telegram_first_name;
+    new.subscription_expires_at := old.subscription_expires_at;
+    new.is_locked := old.is_locked;
+    new.trial_started_at := old.trial_started_at;
+  end if;
+  return new;
+end; $$;
+
+drop trigger if exists trg_protect_telegram_link on public.profiles;
+create trigger trg_protect_telegram_link
+  before insert or update on public.profiles
+  for each row execute function public.protect_telegram_link();
+
+-- One row: the shared secret the SaveIt backend signs its calls with, where
+-- that backend lives, and the bot's username for t.me links. Service role
+-- only (RLS on, no policies).
+create table if not exists public.bridge_config (
+  id integer primary key default 1 check (id = 1),
+  secret text not null,
+  verifier_url text not null,
+  bot_username text,
+  updated_at timestamptz not null default now()
+);
+alter table public.bridge_config enable row level security;
+
+-- Short-lived codes for "sign in with Telegram" from an ordinary browser
+-- (kind = 'login') and for attaching Telegram to an existing phone account
+-- (kind = 'link'). Service role only.
+create table if not exists public.telegram_codes (
+  code text primary key,
+  kind text not null check (kind in ('login', 'link')),
+  user_id uuid references auth.users(id) on delete cascade,
+  telegram_id bigint,
+  telegram_username text,
+  telegram_first_name text,
+  approved_at timestamptz,
+  consumed_at timestamptz,
+  expires_at timestamptz not null,
+  created_at timestamptz not null default now()
+);
+alter table public.telegram_codes enable row level security;
+create index if not exists telegram_codes_expires_idx on public.telegram_codes (expires_at);
