# Settings for scripts/classroom-test.mjs (testing the bot and sending
# homework to students).
#
#   1. Copy this file to classroom.env (same folder). classroom.env is
#      git-ignored, so your keys are never committed.
#   2. Fill in the values below.
#   3. npm run classroom -- check
#
# The same values the backend already uses (Railway variables / .env).

# Bot token from @BotFather -- the bot that is in the class group.
TELEGRAM_LOGIN_BOT_TOKEN=

# The class group's id. Send /chatid in the group and the bot replies with
# it (a negative number such as -1001234567890).
CLASS_CHAT_ID=

# Supabase -> Project Settings -> API: Project URL and service_role key.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Homework sent by `npm run classroom -- homework` when no text is given.
HOMEWORK_TITLE=កិច្ចការផ្ទះ
HOMEWORK_TEXT=សូមធ្វើលំហាត់ទំព័រ 25 លេខ 1-10 ហើយផ្ញើមកវិញមុនថ្ងៃស្អែក ម៉ោង 8 ព្រឹក។
